# --- Fuente de datos -------------------------------------------------------
# sql = SQL Server (producción) | csv = archivo de muestra (desarrollo/demo)
DATA_SOURCE=sql
CSV_PATH=data/Muestra_vista.csv

# --- SQL Server (usar un usuario de SOLO LECTURA sobre la vista) ------------
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
# true = autenticación de Windows (ignora DB_USER/DB_PASSWORD)
DB_TRUSTED_CONNECTION=false
# Nombre de la vista con la estructura de Muestra_vista.csv
VIEW_NAME=dbo.NOMBRE_DE_LA_VISTA
# Estados de documento que cuentan como facturación (separados por coma)
ESTADOS_VALIDOS=Aprobado

# --- Reglas de negocio -------------------------------------------------------
# Categorías para las que se reporta peso (coincidencia por prefijo, sin importar mayúsculas)
CATEGORIAS_PESO=ACERO SIDOC,GR_CEMENTO
# Categorías que se muestran en dinero (COP) junto a las de peso en la segunda tabla
CATEGORIAS_VALOR=PRODUCTOS NO SIDOC
# Canales (columna TipoCliente) que se muestran siempre, en este orden. Coincide también con la forma
# singular/plural (CONSTRUCTOR = CONSTRUCTORES). Otros valores aparecen como filas adicionales.
CANALES=MAYORISTA,MINORISTA,CONSTRUCTORES
# Cada cuántos segundos se recarga la vista en segundo plano
CACHE_TTL_SECONDS=60
# Solo pruebas: simula otra fecha de "hoy" (AAAA-MM-DD). Vacío = fecha real (America/Bogota)
FECHA_HOY=

# --- Agente (chat) -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Acceso web (si APP_USER está vacío, la app queda abierta) -----------------
APP_USER=
APP_PASSWORD=
